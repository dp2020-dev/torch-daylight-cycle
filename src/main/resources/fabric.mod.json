{
	"schemaVersion": 1,
    "id": "torchdaylight",
	"version": "${version}",
    "name": "Torch Daylight Cycle",
    "description": "Dims placed torches to a low smoulder during the day and restores a full flame at night.",
    "authors": [
      "dp2020-dev"
    ],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
    "icon": "assets/torchdaylight/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "com.dp2020dev.torchdaylight.TorchDaylight"
		],
		"client": [
          "com.dp2020dev.torchdaylight.client.TorchDaylightClient"
		]
	},
	"mixins": [
      "torchdaylight.mixins.json",
		{
			"config": "torchdaylight.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}